{
  "name": "mohammedelsaadi",
  "compatibility_date": "2026-03-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Replace this explicit placeholder before deploying directly with Wrangler.
  // Cloudflare Pages dashboard bindings may be used instead for Git-based deploys.
  "d1_databases": [
    {
      "binding": "BOARD_GAME_DB",
      "database_name": "board-game-menu",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "preview_database_id": "local-BOARD_GAME_DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOARD_GAME_MEDIA",
      "bucket_name": "board-game-menu-media",
      "preview_bucket_name": "board-game-menu-media-local"
    }
  ]
}
