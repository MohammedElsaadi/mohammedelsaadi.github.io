{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mohammedelsaadi",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-28",
  "durable_objects": {
    "bindings": [{ "name": "TRAIN_ROOMS", "class_name": "GameSession" }]
  },
  "migrations": [{ "tag": "trains-v1", "new_sqlite_classes": ["GameSession"] }],
  "ratelimits": [
    { "name": "TRAINS_CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "TRAINS_ACCESS_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://mohammedelsaadi.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "BOARD_GAME_DB",
      "database_name": "board-game-menu",
      "database_id": "b16186be-2046-4f09-a89e-640bd9d8fe7e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOARD_GAME_MEDIA",
      "bucket_name": "board-game-menu-media"
    }
  ]
}
